diff --git a/bots/agency-bot/src/vacation.js b/bots/agency-bot/src/vacation.js
new file mode 100644
index 0000000..9150390
--- /dev/null
+++ b/bots/agency-bot/src/vacation.js
@@ -0,0 +1,114 @@
+// בוט לדירות נופש (דוד, "קו המים"): עונה בוואטסאפ האמיתי בדיוק כמו בדמו.
+// המוח (ההוראות, המחירון והסגנון של דוד) משותף עם הדמו: automation-agency/demos/ai/lib/*.js. מחירון אחד, בלי הבדלים.
+// כאן אין גישה ליומן: הבוט לא אומר פנוי/תפוס. כשהלקוח רוצה לסגור, דוד מקבל סיכום בוואטסאפ ומאשר בעצמו.
+import Anthropic from '@anthropic-ai/sdk';
+import { VACATION } from './config.js';
+import { QUOTE_TOOL, israelToday, promptFor, quote, schemaFor } from '../../../automation-agency/demos/ai/lib/bots.js';
+import { displayPhone, ilDateTimeLabel, nowIso } from './util.js';
+import * as wa from './whatsapp.js';
+
+const AI_TIMEOUT_MS = 22000;
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const PHOTO_MARK = '[נשלחו תמונות של דירה ';
+
+const LABELS = { name: 'שם', dates: 'תאריכים', nights: 'לילות', guests: 'אורחים', apartment: 'דירה', occasion: 'אירוע', extras: 'תוספות', price: 'מחיר', discount: 'התמקחות', arrival: 'שעת הגעה', budget: 'תקציב', needs: 'חשוב להם', questions: 'שאלות לבדוק' };
+
+// שיחה אחת עם Claude, כולל הכלי quote (מחיר מדויק מהמחירון). מחזיר את ה-JSON של הדמו: reply, photos, route, lead, ready
+export async function runVacationTurn(env, { history, sent = [], now = new Date() }) {
+  const bot = VACATION.bot || 'david';
+  const today = israelToday(now);
+  const client = new Anthropic({ apiKey: env.ANTHROPIC_API_KEY, timeout: AI_TIMEOUT_MS, maxRetries: 1 });
+  const messages = [];
+  for (const m of history) {
+    const role = m.role === 'assistant' ? 'assistant' : 'user';
+    const last = messages[messages.length - 1];
+    if (last && last.role === role && typeof last.content === 'string') last.content += `\n${m.text}`;
+    else messages.push({ role, content: String(m.text) });
+  }
+  if (!messages.length || messages[0].role !== 'user') messages.unshift({ role: 'user', content: '(פנייה חדשה)' });
+  const system = promptFor(bot, today, { sent, live: true });
+  for (let round = 0; round < 5; round++) {
+    const res = await client.beta.messages.create({
+      model: env.CLAUDE_MODEL || 'claude-sonnet-5-5', max_tokens: 4000, system, messages, tools: [QUOTE_TOOL],
+      output_config: { effort: env.CLAUDE_EFFORT || 'medium', format: { type: 'json_schema', schema: schemaFor(bot) } },
+    });
+    if (res.stop_reason === 'tool_use') {
+      messages.push({ role: 'assistant', content: res.content });
+      messages.push({ role: 'user', content: res.content.filter((b) => b.type === 'tool_use').map((b) => {
+        try { return { type: 'tool_result', tool_use_id: b.id, content: JSON.stringify(quote(bot, today, b.input || {}, { live: true })) }; }
+        catch (e) { return { type: 'tool_result', tool_use_id: b.id, content: String(e.message || e), is_error: true }; }
+      }) });
+      continue;
+    }
+    if (res.stop_reason === 'refusal' || res.stop_reason === 'max_tokens') throw new Error(res.stop_reason);
+    const out = JSON.parse(res.content.filter((b) => b.type === 'text').map((b) => b.text).join(''));
+    if (!String(out.reply || '').trim()) throw new Error('empty');
+    return out;
+  }
+  throw new Error('too_many_rounds');
+}
+
+export function summaryText(lead = {}, phone, now, route, test) {
+  const rows = Object.entries(LABELS).filter(([k]) => String(lead[k] || '').trim()).map(([k, l]) => `${l}: ${lead[k]}`);
+  return [
+    test ? '🧪 מצב בדיקה: ככה ייראה הסיכום שמגיע אליך על כל פנייה' : '',
+    route === 'friends' ? '🏡 תיווך: גדול מדי לדירות. כל הפרטים להעברה לחברים' : '📋 פנייה חדשה: הלקוח רוצה לסגור',
+    ...rows,
+    route === 'friends' ? '' : 'לבדוק זמינות ולשלוח לו פרטים למקדמה',
+    `וואטסאפ ללקוח: https://wa.me/${phone} (${displayPhone(phone)})`,
+    `התקבל: ${ilDateTimeLabel(now)}`,
+  ].filter(Boolean).join('\n');
+}
+
+// הסיכום לדוד בוואטסאפ. במצב בדיקה (דוד הוא גם "הלקוח") הוא מקבל אותו באותה שיחה
+async function sendSummary(env, conv, phone, out, now) {
+  const to = env.SUMMARY_PHONE || env.OWNER_PHONE;
+  if (!to) return;
+  const test = to === phone;
+  const text = summaryText(out.lead || {}, phone, now, out.route, test);
+  const r = await wa.sendText(env, to, text);
+  // מחוץ לחלון של 24 שעות וואטסאפ דוחה הודעה רגילה: שולחים בתבנית המאושרת
+  if (!r?.ok && !test) await wa.sendTemplate(env, to, 'owner_alert_v1', [text.replace(/\n+/g, ' | ').slice(0, 900)]);
+  await env.DB.prepare("UPDATE conversations SET issue = 'vacation_summary_sent', updated_at = ? WHERE id = ?").bind(nowIso(now), conv.id).run();
+}
+
+// תשובה ללקוח שכתב למספר של העסק
+export async function vacationRespond(env, { conv, phone, now = new Date() }) {
+  const rows = (await env.DB.prepare("SELECT role, text FROM messages WHERE conv_id = ? AND role IN ('user','assistant') ORDER BY id").bind(conv.id).all()).results;
+  const sent = [...new Set(rows.filter((m) => m.role === 'assistant' && m.text.startsWith(PHOTO_MARK)).map((m) => m.text.slice(PHOTO_MARK.length, PHOTO_MARK.length + 1)))];
+  const history = rows.filter((m) => !m.text.startsWith(PHOTO_MARK));
+  let out;
+  try { out = await runVacationTurn(env, { history, sent, now }); }
+  catch (err) {
+    console.error('vacation turn failed', err?.status || '', err?.message || err);
+    try { await sleep(800); out = await runVacationTurn(env, { history, sent, now }); }
+    catch (err2) {
+      // תוכנית ב' בוואטסאפ האמיתי: הלקוח מקבל תשובה אנושית, ודוד מקבל התראה להמשיך בעצמו
+      console.error('vacation turn failed twice', err2?.message || err2);
+      const msg = 'רגע אחי, אני בודק ומחזיר לך תשובה עוד כמה דקות 🙏';
+      await wa.sendText(env, phone, msg);
+      await env.DB.prepare("INSERT INTO messages (conv_id, role, text, created_at) VALUES (?, 'assistant', ?, ?)").bind(conv.id, msg, nowIso(now)).run();
+      const to = env.SUMMARY_PHONE || env.OWNER_PHONE;
+      if (to) await wa.sendText(env, to, `⚠️ הבוט לא הצליח לענות ל-${displayPhone(phone)}. כדאי לענות לו בעצמך: https://wa.me/${phone}`);
+      return;
+    }
+  }
+  const parts = String(out.reply).split(/\n\s*\n/).map((x) => x.trim()).filter(Boolean).slice(0, 3);
+  const gap = () => (env.VACATION_GAP_MS != null ? +env.VACATION_GAP_MS : 1200 + Math.floor(Math.random() * 1500));
+  const photoId = /^[123]$/.test(String(out.photos || '')) ? String(out.photos) : '';
+  const pics = photoId && !sent.includes(photoId) ? (VACATION.photos?.[photoId] || []) : [];
+  for (let i = 0; i < parts.length; i++) {
+    if (i > 0) await sleep(gap());
+    // הכפתורים (תשובות מהירות) על ההודעה האחרונה, שבה השאלה
+    const last = i === parts.length - 1, btns = last ? (out.buttons || []).filter((b) => String(b).trim()).slice(0, 3) : [];
+    const r = btns.length ? await wa.sendButtons(env, phone, parts[i], btns) : await wa.sendText(env, phone, parts[i]);
+    if (btns.length && !r?.ok) await wa.sendText(env, phone, parts[i]);
+    await env.DB.prepare("INSERT INTO messages (conv_id, role, text, created_at) VALUES (?, 'assistant', ?, ?)").bind(conv.id, parts[i], nowIso(now)).run();
+    // התמונות אחרי ההודעה שממליצה על הדירה (כמו דוד: קודם הדירה, אחר כך השאלה)
+    if (pics.length && i === Math.max(0, parts.length - 2)) {
+      for (let k = 0; k < pics.length; k++) await wa.sendImageByLink(env, phone, pics[k], k === 0 ? (VACATION.names?.[photoId] || '') : '');
+      await env.DB.prepare("INSERT INTO messages (conv_id, role, text, created_at) VALUES (?, 'assistant', ?, ?)").bind(conv.id, `${PHOTO_MARK}${photoId}]`, nowIso(now)).run();
+    }
+  }
+  if (out.ready && conv.issue !== 'vacation_summary_sent') { await sleep(1500); await sendSummary(env, conv, phone, out, now); }
+}
