+  assert.equal(await handleMissedCall(env, CUSTOMER, new Date(day.getTime() + 3600000)), 'skipped:already messaged');
+
+  // לקוח שכתב ב-24 השעות האחרונות: טקסט רגיל ולא תבנית
+  const B = '972521112233';
+  env.DB.raw.prepare('INSERT INTO customers (phone, first_seen, last_inbound_at) VALUES (?, ?, ?)').run(B, day.toISOString(), day.toISOString());
+  sent.length = 0;
+  assert.equal(await handleMissedCall(env, B, day), 'sent');
+  assert.match(sent.find((m) => m.to === B).text.body, /ראינו שהתקשרת/);
+
+  // איש קשר שמור, ובעל העסק עצמו: לא שולחים
+  const C = '972531112233';
+  env.DB.raw.prepare('INSERT INTO customers (phone, first_seen, known) VALUES (?, ?, 1)').run(C, day.toISOString());
+  assert.equal(await handleMissedCall(env, C, day), 'skipped:saved contact');
+  assert.equal(await handleMissedCall(env, OWNER, day), 'skipped:owner');
+  assert.equal(await handleMissedCall(env, '97239876543', day), 'skipped:not a mobile number');
+
+  // שיחה בלילה: מחכה, ונשלחת בבוקר. ואם הלקוח כתב בינתיים, לא שולחים
+  const D = '972541119999', E = '972541118888';
+  const night = new Date('2026-11-23T21:30:00Z'); // 23:30
+  sent.length = 0;
+  assert.equal(await handleMissedCall(env, D, night), 'queued');
+  assert.equal(await handleMissedCall(env, E, night), 'queued');
+  assert.equal(sent.length, 0);
+  env.DB.raw.prepare('INSERT INTO customers (phone, first_seen, last_inbound_at) VALUES (?, ?, ?)').run(E, night.toISOString(), new Date(night.getTime() + 600000).toISOString());
+  await flushMissedCalls(env, new Date('2026-11-24T00:30:00Z')); // 02:30 עוד לילה
+  assert.equal(sent.length, 0);
+  await flushMissedCalls(env, new Date('2026-11-24T06:15:00Z')); // 08:15
+  assert.equal(sent.filter((m) => m.to === D).length, 1);
+  assert.equal(sent.filter((m) => m.to === E).length, 0);
+
+  // כבוי ללקוח: הכתובת לא קיימת
+  FEATURES.missedCalls = false;
+  const off = await worker.fetch(new Request('https://bot.example/missed-call?key=callkey&from=0541234567'), env, { waitUntil() {} });
+  assert.equal(off.status, 404);
