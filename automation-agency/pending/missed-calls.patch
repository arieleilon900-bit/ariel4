diff --git a/bots/agency-bot/src/missedcall.js b/bots/agency-bot/src/missedcall.js
new file mode 100644
index 0000000..8d3d841
--- /dev/null
+++ b/bots/agency-bot/src/missedcall.js
@@ -0,0 +1,93 @@
+// שיחה שלא נענתה ← הודעה בוואטסאפ.
+// בעל העסק מגדיר בטלפון "אם לא עניתי / תפוס, תעביר" למספר וירטואלי אצל ספק טלפוניה.
+// הספק שולח לנו (GET או POST) את המספר של מי שהתקשר: /missed-call?key=MISSED_CALL_KEY&from=0541234567
+// הבוט שולח ללקוח הודעה (תבנית מאושרת missed_call_v1, או טקסט רגיל אם הלקוח כתב ב-24 השעות האחרונות),
+// ומהרגע שהלקוח עונה, השיחה ממשיכה כרגיל עם הבוט.
+import { FEATURES, MESSAGES, TEMPLATES, TIMING } from './config.js';
+import { customerHours } from './hours.js';
+import { displayPhone, nowIso, normalizePhone } from './util.js';
+import { logEvent, sendToCustomer, sendToOwner } from './handler.js';
+
+// השדות שבהם ספקי טלפוניה שונים שולחים את המספר של המתקשר
+const PHONE_FIELDS = ['from', 'caller', 'caller_id', 'callerid', 'CallerNumber', 'caller_number', 'phone', 'number', 'ani', 'From', 'CallerID', 'src', 'source'];
+
+export function pickCaller(obj = {}) {
+  for (const k of PHONE_FIELDS) {
+    const v = obj[k] ?? obj[k.toLowerCase()];
+    if (v && /\d{7,}/.test(String(v).replace(/\D/g, ''))) return normalizePhone(String(v));
+  }
+  return '';
+}
+
+async function readCaller(request, url) {
+  const q = Object.fromEntries(url.searchParams);
+  let caller = pickCaller(q);
+  if (caller || request.method !== 'POST') return caller;
+  const raw = await request.text().catch(() => '');
+  try { caller = pickCaller(JSON.parse(raw)); } catch { caller = pickCaller(Object.fromEntries(new URLSearchParams(raw))); }
+  return caller;
+}
+
+// הכניסה מהשרת (index.js)
+export async function missedCallRequest(env, request, url, now = new Date()) {
+  if (!FEATURES.missedCalls) return new Response('missed calls are off for this client', { status: 404 });
+  const key = String(env.MISSED_CALL_KEY || '').trim();
+  if (!key || (url.searchParams.get('key') || '').trim() !== key) return new Response('forbidden', { status: 403 });
+  const phone = await readCaller(request, url);
+  if (!phone) return new Response('no caller number', { status: 400 });
+  const r = await handleMissedCall(env, phone, now);
+  return new Response(r, { headers: { 'content-type': 'text/plain; charset=utf-8' } });
+}
+
+// מחזיר מה קרה (לבדיקות וללוג): sent / queued / skipped:<סיבה>
+export async function handleMissedCall(env, phone, now = new Date()) {
+  const skip = async (why) => {
+    await env.DB.prepare('INSERT INTO missed_calls (phone, created_at, skipped) VALUES (?, ?, ?)').bind(phone, nowIso(now), why).run();
+    return `skipped:${why}`;
+  };
+  if (!/^9725\d{8}$/.test(phone)) return skip('not a mobile number'); // קווי או חו"ל: אין וואטסאפ / לא שולחים
+  if (phone === env.OWNER_PHONE || phone === env.ADMIN_PHONE) return skip('owner');
+  if (env.TEST_PHONES && !String(env.TEST_PHONES).split(',').map((p) => p.trim()).includes(phone)) return skip('test mode');
+  const c = await env.DB.prepare('SELECT known, blocked, opted_out FROM customers WHERE phone = ?').bind(phone).first();
+  if (c?.known) return skip('saved contact');
+  if (c?.blocked) return skip('blocked');
+  if (c?.opted_out) return skip('opted out');
+  // אותו מספר התקשר כמה פעמים: הודעה אחת בלבד בכל פרק זמן
+  const since = new Date(now.getTime() - TIMING.missedCallCooldownHours * 3600000).toISOString();
+  const recent = await env.DB.prepare('SELECT 1 FROM missed_calls WHERE phone = ? AND skipped IS NULL AND created_at >= ? LIMIT 1').bind(phone, since).first();
+  if (recent) return skip('already messaged');
+
+  const ins = await env.DB.prepare('INSERT INTO missed_calls (phone, created_at) VALUES (?, ?)').bind(phone, nowIso(now)).run();
+  await logEvent(env, 'missed_call', phone, now);
+  if (!customerHours(now)) return 'queued'; // לילה, שבת או חג: נשלח בבוקר (cron)
+  await sendMissedCallMessage(env, ins.meta?.last_row_id, phone, now);
+  return 'sent';
+}
+
+async function sendMissedCallMessage(env, id, phone, now) {
+  await env.DB.prepare(
+    `INSERT INTO customers (phone, first_seen) VALUES (?, ?) ON CONFLICT(phone) DO NOTHING`,
+  ).bind(phone, nowIso(now)).run();
+  await sendToCustomer(env, phone, MESSAGES.missedCall, { name: TEMPLATES.missedCall, params: [] }, now);
+  await env.DB.prepare('UPDATE missed_calls SET sent_at = ? WHERE id = ?').bind(nowIso(now), id).run();
+  if (FEATURES.missedCallNotifyOwner) {
+    await sendToOwner(env, `📞 שיחה שלא נענתה מ-${displayPhone(phone)}. שלחתי לו הודעה בוואטסאפ, ואם הוא יענה הבוט ימשיך איתו כרגיל.`, now, phone);
+  }
+}
+
+// cron: מה שהגיע בלילה או בשבת נשלח כשמותר (רק שיחות מ-12 השעות האחרונות, אחרת זה כבר לא רלוונטי)
+export async function flushMissedCalls(env, now = new Date()) {
+  if (!FEATURES.missedCalls || !customerHours(now)) return;
+  const since = new Date(now.getTime() - 12 * 3600000).toISOString();
+  const rows = (await env.DB.prepare('SELECT id, phone FROM missed_calls WHERE sent_at IS NULL AND skipped IS NULL AND created_at >= ? ORDER BY id LIMIT 20').bind(since).all()).results;
+  for (const r of rows) {
+    // בינתיים הלקוח כבר כתב בעצמו: לא צריך את ההודעה
+    const wrote = await env.DB.prepare('SELECT last_inbound_at FROM customers WHERE phone = ?').bind(r.phone).first();
+    if (wrote?.last_inbound_at && wrote.last_inbound_at >= since) {
+      await env.DB.prepare("UPDATE missed_calls SET skipped = 'customer wrote' WHERE id = ?").bind(r.id).run();
+      continue;
+    }
+    await sendMissedCallMessage(env, r.id, r.phone, now);
+  }
+}
+
